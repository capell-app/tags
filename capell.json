{
    "manifest-version": 3,
    "name": "capell-app/tags",
    "slug": "tags",
    "displayName": "Tags",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "One list of tags for pages and articles, with merging of duplicates and bulk tagging from the Pages list.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\Tags",
    "surfaces": ["admin", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/navigation"
        ],
        "supports": ["capell-app/publishing-studio"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": ["Capell\\Tags\\Providers\\ConsoleServiceProvider"],
        "runtime": ["Capell\\Tags\\Providers\\TagsServiceProvider"],
        "admin": ["Capell\\Tags\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\Tags\\Manifest\\TagResourceContribution",
            "resourceClass": "Capell\\Tags\\Filament\\Resources\\Tags\\TagResource",
            "label": "Tags taxonomy admin resource."
        },
        {
            "type": "model",
            "class": "Capell\\Tags\\Manifest\\TagsModelsContribution",
            "modelClasses": [
                "Capell\\Tags\\Models\\Tag",
                "Capell\\Tags\\Models\\Taggable"
            ]
        },
        {
            "type": "migration",
            "class": "Capell\\Tags\\Manifest\\TagsMigrationsContribution",
            "tables": ["tags", "taggables"],
            "migrationFiles": [
                "2026_05_10_190872_01_alter_tags_table",
                "2026_06_04_000001_add_type_site_id_index_to_tags_table",
                "2026_07_10_000001_add_merged_slug_aliases_to_tags_table",
                "2026_08_15_000001_add_status_to_tags_table"
            ]
        },
        {
            "type": "console-command",
            "class": "Capell\\Tags\\Manifest\\TagsConsoleCommandsContribution",
            "commands": ["capell:tags-install"],
            "commandClasses": [
                "Capell\\Tags\\Console\\Commands\\InstallCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\Tags\\Health\\TagsHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["tags", "taggables"]
    },
    "commands": {
        "install": "capell:tags-install",
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "buildTagCloud": "Capell\\Tags\\Actions\\BuildTagCloudAction",
        "findRelatedTaggables": "Capell\\Tags\\Actions\\FindRelatedTaggablesAction",
        "install": "Capell\\Tags\\Actions\\InstallTagsPackageAction",
        "managePageTags": "Capell\\Tags\\Actions\\ManagePageTagsAction",
        "mergeTags": "Capell\\Tags\\Actions\\MergeTagsAction",
        "resolveTagBySlug": "Capell\\Tags\\Actions\\ResolveTagBySlugAction"
    },
    "settings": [],
    "permissions": [
        "ViewAny:Tag",
        "View:Tag",
        "Create:Tag",
        "Update:Tag",
        "Delete:Tag",
        "DeleteAny:Tag",
        "Restore:Tag",
        "RestoreAny:Tag",
        "ForceDelete:Tag",
        "ForceDeleteAny:Tag",
        "Replicate:Tag",
        "Reorder:Tag"
    ],
    "capabilities": [],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "ViewAny:Tag",
                "View:Tag",
                "Create:Tag",
                "Update:Tag",
                "Delete:Tag",
                "DeleteAny:Tag",
                "Restore:Tag",
                "RestoreAny:Tag",
                "ForceDelete:Tag",
                "ForceDeleteAny:Tag",
                "Replicate:Tag",
                "Reorder:Tag"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": ["tags"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Tags\\Models\\Tag",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Tags\\Models\\Taggable",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "tags.package-health",
            "label": "Tags package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\Tags\\Health\\TagsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Merge tags that mean the same thing after a preview, and tag many pages at once, so editors work from one tidy list.",
        "description": "Manage every tag from one list in the admin. Give tags a name and address, keep them to a single site or share them across sites, and see where each one is used. Merge duplicates after a preview of what will change, and add or remove tags on many pages at once from the Pages list.",
        "problem": "Our editors type the same tag several ways, and I can't tell how many pages use each one.",
        "outcome": "Editors keep one clean list of tags and tag many pages at once.",
        "faq": [
            {
                "question": "I have several tags that mean the same thing. Can I combine them?",
                "answer": "Yes. Tick them in the list, choose Merge tags and pick the one to keep. Capell shows how many pages and articles will change before you confirm, and the tags must be the same type and on the same site, or all shared."
            },
            {
                "question": "Can site editors change shared tags?",
                "answer": "No. Site editors can see shared tags but change only their own site's."
            },
            {
                "question": "Does Tags give my site public tag pages?",
                "answer": "No. Tags shows visitors nothing itself, so public tag pages come from Blog, Capell's blogging package. With Blog installed, a visitor who follows an old tag's address reaches the kept tag's page."
            },
            {
                "question": "Can I undo deleting a tag?",
                "answer": "No. Deleting a tag is permanent."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Tags listing card with two small admin windows, a tag list showing No Tags and a Create Tag form",
                "caption": "Listing artwork for the package, not a working screen."
            },
            {
                "path": "docs/screenshots/tags-admin-index.png",
                "alt": "Tags list with Archived campaign, Editorial and Product updates, site tabs along the top and featured and status columns",
                "caption": "See each tag's web address, site and usage count, and whether it is featured or active."
            },
            {
                "path": "docs/screenshots/create-edit-tag-form.png",
                "alt": "Create Tag form with name, slug, page type, site, a Featured box and Active and Inactive choices",
                "caption": "Give a tag a name and web address, then choose its site and whether it is active."
            },
            {
                "path": "docs/screenshots/create-edit-tag-form-dark.png",
                "alt": "Create Tag form in dark mode with the same empty fields and Active and Inactive choices",
                "caption": "The tag form in the dark admin theme, with the same fields and actions."
            }
        ],
        "categories": ["admin", "console", "foundation"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    },
    "install": {
        "legacyTables": [
            {
                "name": "tags",
                "configKey": "capell.database.external_tables.tags",
                "migration": "create_tag_tables"
            },
            {
                "name": "taggables",
                "configKey": "tags.taggable.table_name",
                "migration": "create_tag_tables"
            }
        ]
    }
}
